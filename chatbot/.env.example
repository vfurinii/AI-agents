# OpenAI Configuration
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# WhatsApp Business API Configuration
# Get these from: https://developers.facebook.com/apps

# Phone Number ID - found in WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Access Token - Generate in WhatsApp > API Setup > Temporary access token
# For production, create a permanent System User token
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Verify Token - Create your own random string for webhook verification
WHATSAPP_VERIFY_TOKEN=my_secret_verify_token_12345

# Instructions:
# 1. Copy this file to .env (do not commit .env to git!)
# 2. Fill in the actual values
# 3. Load environment variables before running the application
#
# Windows PowerShell:
#   Get-Content .env | ForEach-Object {
#     if ($_ -match '^([^=]+)=(.*)$') {
#       [System.Environment]::SetEnvironmentVariable($matches[1], $matches[2], "Process")
#     }
#   }
#
# Linux/Mac:
#   export $(cat .env | xargs)

